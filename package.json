{
  "name": "bilim-arena",
  "productName": "Bilim Arena",
  "version": "0.5.0",
  "description": "Sensorli elektron doska uchun jamoaviy ta'limiy o'yinlar",
  "author": "Bilim Arena",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "release": "vite build && electron-builder --win --publish always",
    "postinstall": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.12",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1",
    "write-excel-file": "^4.1.1"
  },
  "build": {
    "appId": "uz.bilimarena.app",
    "productName": "Bilim Arena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ShaxzodRuziqulov",
        "repo": "bilim-arena",
        "releaseType": "draft"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
